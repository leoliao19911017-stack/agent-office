#!/bin/sh
# G07 提交门禁（本地提交检查）：四页启动流程回归全部通过才放行。
# 用例：首屏加载×4 / 导航与刷新×4 / API 异常与恢复×4 / 路由清单×3（共 15 条，约 1-2 分钟，
# 含真实退避恢复等待）。核心用例失败 = 提交被阻止，防止「页面只剩外壳」的版本再进主干。
# 激活方式：git config core.hooksPath scripts/hooks
cd "$(dirname "$0")/../.." || exit 1
echo "[pre-commit] G07 四页回归启动（test/g07-*.test.js，约 1-2 分钟）…"
npm run --silent test:g07
code=$?
if [ "$code" -ne 0 ]; then
  echo ""
  echo "[pre-commit] ❌ G07 回归失败（exit $code）——本次提交已被阻止。"
  echo "[pre-commit] 修复后再提交；临时绕过（不建议，需自行承担）：git commit --no-verify"
  exit "$code"
fi
echo "[pre-commit] ✅ G07 回归 15/15 通过。"
