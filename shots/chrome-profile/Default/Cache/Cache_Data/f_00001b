/* app-layers.css —— G02（第 5 轮）自 app.css 拆分：W01 审批材料门禁起的历轮评审覆盖层（必须最后加载,源顺序即覆盖顺序）。加载顺序 4/4。 */
/* ================= W01：审批材料类型门禁 =================
   开发计划步骤的审批对象必须是声明了计划类型的产物：
   - 类型不符 → 警示块（金底警示，明确规则与出路），主操作禁用（实底灰，不半透明）
   - 测试策略豁免 → 证据卡里展示依据（.ev-policy），不静默放行
   服务端 /api/office/decision 同步 409 拒绝，前端禁用只是先让用户看到原因。 */
.invalid-material {
  margin: 2px 0 4px;
  padding: 12px;
  background: #342C20;
  color: var(--amber);
  border-radius: 8px;
  font-size: 13px;
  line-height: 20px;
  overflow-wrap: anywhere;
}
/* 无效材料时的主操作：规格 36px 高 / 8px 圆角 / #575044 实底。
   覆盖 .btn:disabled 的半透明 + .btn-primary 的琥珀渐变，保持可读的「明确禁用」形态。 */
.ip-decide .acts .btn.btn-invalid-material {
  height: 36px;
  min-height: 36px;
  border-radius: 8px;
  background: #575044;
  color: #B4AA99;
  cursor: not-allowed;
  opacity: 1;
  filter: none;
}
.ip-decide .acts .btn.btn-invalid-material:disabled { opacity: 1; }
/* 证据卡里的类型要求 / 测试策略标注 */
.ev .ev-policy {
  color: var(--muted);
  font-size: 12px;
  line-height: 18px;
}

/* ================= G01：统一高频元信息（图1 需求列表 / 图2 Agents 名册 / 图3 技能卡 / 图4 文件库） =================
   口径：普通辅助文字 12px/18px/var(--meta) · 重要状态文字 13px/20px/var(--meta-hi)。
   「没数据=—」的诚实弱化档（--faint：work-unknown / hb off 未连 / hist 历史 / na 无实测）独立保留，不并入统一提亮；
   品牌语义色不动（琥珀=待拍板/超时 · 绿=完成/在线/实测一致 · 红=故障 · 蓝=选中/执行中）；
   标签类（.sk-tag/.sk-cat/.lf-tag/.lf-type，非长篇阅读文本）保持 11px/16px，仅提色到可读档；
   文件路径保留等宽字体，字号 ≥12px。主背景 var(--bg) / 卡片 var(--card) 不改。 */
/* G02（第 5 轮）：--meta/--meta-strong 前移至文件头主 :root 集中定义 */

/* —— 图1 · 需求列表：状态文字归重要档 13/20，阶段/筛选计数归辅助档 12/18 —— */
.req-line2 { line-height: 20px; }
.req-status { font-size: 13px; line-height: 20px; }
.req-status.t-queued { color: var(--meta-strong); }
.req-stage { font-size: 12px; line-height: 18px; color: var(--meta); }
.reqs-partial { line-height: 18px; }

/* —— 图2 · Agents 名册：表头/标识/角色提亮，常态状态归 var(--meta-hi) —— */
.roster-head { line-height: 18px; color: var(--meta); }
.ag-ids { font-size: 12px; line-height: 18px; color: var(--meta); }
.ag-idcol .agent-role { line-height: 18px; color: var(--meta); }
.ag-conn.off, .ag-work.work-idle { color: var(--meta-strong); }   /* A02r3：.ag-hb 两态移出——归业务上报三色（见文件尾覆盖层） */
.ag-task { color: var(--meta-strong); }
#agent-scope { color: #8FA3BA; }   /* A01：范围说明最终色（覆盖上方 --muted） */
.agent-kv, .agent-run p { color: var(--meta); }

/* —— 图3 · 技能卡：描述归辅助档 12/18/var(--meta)，标签保持 11/16 仅提色 —— */
.skill-row small { font-size: 12px; line-height: 18px; color: var(--meta); }
.sk-cat { color: var(--meta); }
.skill-path { font-size: 12px; line-height: 18px; color: var(--meta); }
#skill-count { font-size: 12px; line-height: 18px; color: var(--meta); }
.sfr-label { color: var(--meta); }

/* —— 图4 · 文件库：路径/大小/来源标签提亮（路径等宽 12px 保留） —— */
#file-count { font-size: 12px; line-height: 18px; color: var(--meta); }
.file-only { font-size: 12px; line-height: 18px; color: var(--meta); }
.library-file .lf-src { color: var(--meta); }
.library-file .lf-size { color: var(--meta); }
.lf-type { color: var(--meta); }
.ff-title { color: var(--meta); }
.ff-note { color: var(--meta); }
.fv-path { color: var(--meta); }
.fvd-row span { color: var(--meta); }
/* 行高反压：.skilldetail p{line-height:1.8} (0,1,1) 与 .fv-path 继承的 1.6 会把两处路径行盒撑到 21.6/19.2px */
.skilldetail .skill-path { line-height: 18px; }
.fv-path { line-height: 18px; }

/* —— G01（第 3 轮，2026-11-16）：评审连续两轮点名弱化档文字仍偏暗，收回上一轮的 faint 豁免。
   var(--faint) 只留给真正的「—」无数据占位（.sk-na 等），不再用于需要用户判断的状态文字；
   agent-kv / fvd-row 分别收进 12/18 辅助档与 13/20 状态档（原 14/22、13/24 均为继承/残留行高，档位外）。
   实测依据 verify-g01-baseline.json：work-unknown / ag-task.hist / agent-kv 标签 = var(--faint) C5.87。 —— */
.ag-work.work-unknown { color: var(--meta-strong); }   /* 「未知」是要判断的状态 → var(--meta-hi) */
.ag-task.hist { color: var(--meta-strong); }           /* 「上次上报已过期」告警 → var(--meta-hi)（13/20 不变） */
.sc-label { color: var(--meta); }                      /* 图2 顶部统计卡标签 → var(--meta) */
.agent-kv { font-size: 12px; line-height: 18px; }      /* 明细 KV 行统一辅助档（覆盖 .module-page 的 14/22 继承） */
.agent-kv span:first-child { color: var(--meta); }     /* KV 标签不再用弱化灰 */
/* 图4 预览来源行：标签 12/18/var(--meta)；数值（执行者/校验状态/大小）是判断依据 → 13/20/var(--meta-hi)；
   24px 行盒与 b.warn 琥珀品牌色（1419）不动 */
.fvd-row span { font-size: 12px; line-height: 18px; color: var(--meta); }
.fvd-row b { font-size: 13px; line-height: 20px; color: var(--meta-strong); }
/* 收尾：lf-exec（执行者）原走 --text 亮过头，lf-lines 双值大小原为 F01 的 var(--meta-num) 强调色，均档位外 → 统一辅助档；
   一致态 ✓ 保留完成绿（品牌语义），.lf-exec.na「—」占位保留诚实弱化档 */
.library-file .lf-exec { color: var(--meta); }
.library-file .lf-exec.na { color: var(--faint); }
.library-file .lf-lines .lf-size { color: var(--meta); }
.library-file .lf-size.ok { color: var(--green); }
.lf-tag.unver { color: var(--meta); }   /* 5.41→6.47：未核实标签与其他标签同色，靠底色区分态 */

/* ================= W01（版本轮）：审批材料与提交登记不一致警示 =================
   审批面板按当前物理文件实时核对，实测≠登记（或登记缺失）时在审批详情里逐条列出，
   让「批的是变化后的文件」这件事看得见，不再只剩一个实测值冒充原始提交材料。
   规格（W02 第 10 轮按任务书更新）：var(--amber) on #342C20 / 圆角 8px / 内边距 12px /
   段落间距 12px——审批面板内与 .invalid-material（类型门禁，同规格）统一，
   中央 .hf-tag.mism、文件库 .lf-tag.mism 仍用旧 var(--amber-bg)/6px 标签规范，不在本轮范围。
   比较口径在判定层（服务端 version-gate，原始字节数 + sha256），本块只做展示。
   与 .invalid-material（类型门禁）并列各说各的事：这里只提示版本事实，不加新操作。 */
.material-mismatch {
  margin: 12px 0;
  padding: 12px;
  background: #342C20;
  color: var(--amber);
  border-radius: 8px;
  font-size: 12px;
  line-height: 18px;
  overflow-wrap: anywhere;
}

/* ================= F01（第 4 轮）：登记大小逐条核对后的展示口径 =================
   与上方「收尾」辅助档刻意冲突、按本轮任务规格执行（同特异性下源顺序取胜）：
   大小双行是核对结论而非普通辅助文字——12px / 行高 18px / var(--meta-num) / 行间距 4px；
   异常标签 22px / 圆角 6px / var(--amber-bg) 底 var(--amber) 字；一致态数值用完成绿 var(--green)；
   行最小高 68px；登记大小不同时逐条分列（步骤号 + 真实登记值），行高自然增长不截断。 */
.library-file .lf-lines { gap: 4px; }
.library-file .lf-lines .lf-size { font-size: 12px; line-height: 18px; color: var(--meta-num); }
.library-file .lf-size.ok { color: var(--green); }
.lf-tag.mism { height: 22px; border-radius: 6px; background: var(--amber-bg); color: var(--amber); font-size: 12px; line-height: 18px; }
.library-file { min-height: 68px; }

/* ================= G01（第 4 轮，2026-11-16）：辅助文字档位收口 + 纸底状态对比度 =================
   评审第 3 轮反馈：图2 实例标识、图4 绝对路径等宽 12px 光学上仍偏小（Cascadia/Consolas 的 x-height 小于
   Segoe UI 同字号），不同页面辅助文字视觉权重不一致；且全 DOM 巡检（verify-g01r4-baseline.json，
   1440×900 + 1280×800 双视口 657 节点）发现 41 个硬违规节点。本轮口径：
   ① 档位制不变：辅助 12/18/var(--meta)（--meta）· 状态与关键元数据 13/20/var(--meta-hi)（--meta-strong）· 短标签 11/16。
   ② 等宽关键元数据（实例标识 / 文件绝对路径）升 13/20/--meta-strong——等宽字体光学偏小，13px 等宽 ≈ 12px
      无衬线的视觉重量，路径等宽字体保留。
   ③ 来源标签（lf-type / lf-tag）11px→12px：高度固定的胶囊盒（20px/22px）装得下 18px 行高，不改行结构。
   ④ var(--muted)（--muted）辅助文字全部归 var(--meta)；var(--faint)（--faint）只留给纯「—」无数据占位，
      带说明文字的占位（sk-na「—（原因）」）按辅助档提亮。
   ⑤ 纸底（#inspector / .step-card.sel，#F1EADB）上的状态胶囊换深色：现有 --ink-green/--ink-amber/--ink-muted
      在纸上算得 C 3.9–4.2 不达标，改用实测达标深色（#1E6B40 C5.43 · #75590F C5.5 · --ink-red C4.95 ·
      --ink C≈13，按 #F1EADB 计算）；暗底上的状态胶囊（品牌语义色 C≥7）不动。
   刻意不动：.lf-lines .lf-size 的 var(--meta-num)（F01 第 4 轮规格，跨任务冲突按源顺序保留，C12.56 达标）；
   .lf-name 14/22（标题档）；.fv-panel 正文 12.5px（文件内容非辅助文字）；rail 导航按钮与表单控件；
   .st 胶囊字号 12px（紧凑状态胶囊 ≥ 下限，主列表 .req-status 已是 13/20）。 */
/* —— ② 等宽关键元数据升 13/20/var(--meta-hi)（评审点名「仍较细小」的四类） —— */
.ag-ids { font-size: 13px; line-height: 20px; color: var(--meta-strong); }
.library-file .lf-src { font-size: 13px; line-height: 20px; color: var(--meta-strong); }
.fv-path { font-size: 13px; line-height: 20px; color: var(--meta-strong); }
.skill-path { font-size: 13px; line-height: 20px; color: var(--meta-strong); }
.skilldetail .skill-path { line-height: 20px; } /* 反压 .skilldetail p{line-height:1.8} 的 (0,2,0) 覆盖 */
/* —— ③ 来源标签 11px→12px（胶囊盒高度不变） —— */
.lf-type { font-size: 12px; line-height: 18px; }
.lf-tag { font-size: 12px; line-height: 18px; }
/* —— ⑤ 纸底状态胶囊：深色可读版（仅纸面生效，暗底品牌色不动） —— */
#inspector .st-done, .step-card.sel .st-done { color: #1E6B40; background: rgba(30, 107, 64, .12); }
#inspector .st-running, #inspector .st-awaiting,
.step-card.sel .st-running, .step-card.sel .st-awaiting { color: #75590F; background: rgba(117, 89, 15, .14); }
#inspector .st-pending, #inspector .st-skipped, #inspector .st-waitpre,
.step-card.sel .st-pending, .step-card.sel .st-skipped, .step-card.sel .st-waitpre { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
#inspector .st-failed, .step-card.sel .st-failed { color: var(--ink-red); background: color-mix(in srgb, var(--ink-red) 12%, transparent); }
/* —— ④ 弱化灰收口：真文字不用 var(--faint) / var(--muted)（图1 检验面板 · 顶栏 · 状态栏 · 各页表头） —— */
.ch-id { color: var(--meta); }
.ev-k { color: var(--meta); line-height: 18px; }
.note-cnt { color: var(--meta); line-height: 18px; }
.ip-sec-h .chk-at, .chk-at { color: var(--meta); line-height: 18px; }
.ev-file small.ev-file-meta { font-size: 12px; line-height: 18px; color: var(--meta); }
.ip-time { color: var(--meta); line-height: 18px; }
.ip-file .fb, .ip-file .fb.reg { font-size: 12px; line-height: 18px; color: var(--meta); }
.ip-link .ls.k-waitpre { color: var(--meta-strong); } /* 「等待前置」是要判断的状态 → 13/20 档色 */
.ev-src { color: var(--meta); line-height: 18px; }
.ev .ev-policy { color: var(--meta); }
.ev .ev-v { color: var(--meta-strong); } /* 检验值归状态档色（原 --text #F1ECE2 档外偏亮） */
.eyebrow { font-size: 11px; line-height: 16px; color: var(--meta); } /* 10px 低于字号下限 */
.sb-chip, .sb-chip.idle, .sb-chip.unknown { color: var(--meta); } /* 名册名是真文字；状态点色(:1000-1005)不动 */
#sb-sync { color: var(--meta); }
#statusbar > span { color: var(--meta); }
.reqs-head { color: var(--meta); line-height: 18px; }
.ss-meta { color: var(--meta); }
.hf-meta { color: var(--meta); }
.ch-sub { color: var(--meta-strong); } /* 顶栏当前需求副题 = 关键元数据（13/20 已达标） */
#tb-task { color: var(--meta-strong); line-height: 20px; } /* 顶栏当前任务指示（13px 已达标，色归档） */
p.agent-role { color: var(--meta); line-height: 18px; } /* 图2 明细区角色说明段（列表内 span 已落档） */
#skill-pagination span { font-size: 12px; line-height: 18px; color: var(--meta); }
.sk-na { font-size: 12px; line-height: 18px; color: var(--meta); } /* 「—（原因）」带说明文字 → 辅助档；纯「—」占位仍走 --faint */

/* ================= F01（第 5 轮）：文件行路径字号按本轮规格收口 =================
   本轮任务规格：文件名 14px/22px、路径 12px/18px。:1602 的 G01 13/20 升档是全局
   等宽关键元数据口径，但文件库行内路径以本轮 F01 规格为准——同特异性 (0,2,0)
   下源顺序取胜。仅改字号/行高，颜色仍走 --meta-strong，其余页面路径类不动。 */
.library-file .lf-src { font-size: 12px; line-height: 18px; }

/* ================= W01（底部固定操作区轮）：审批操作固定在右栏底部 =================
   审批卡说明变长后按钮被推出首屏（改前实测 y1149.8..1185.8，三视口全在屏外）。
   #inspector 已是纵向 flex（高 = 100vh - 108 = topbar 52 + statusbar 56）：
   .insp-head 固定头 / #insp-body 弹性滚动体（W02 已就位）/ #insp-foot 固定底。
   按钮仍带 data-decide 走 document 级事件委托，移位不改点击行为。 */
.insp-head {
  height: 48px; display: flex; align-items: center; box-sizing: border-box;
}
#insp-foot {
  flex: none; height: 64px; padding: 12px 16px;
  /* W02 本轮：底栏规格色按任务书收口——背景 #111823 + 顶部分隔线 1px #334155
     （此前 r13 的旧底色/旧边框色仅色值偏差，几何不动）。 */
  background: #111823; border-top: 1px solid var(--line);
  box-sizing: border-box;
}
/* 反制「display 击穿 hidden」：不写这条，无审批的步骤会留 64px 空白占位。 */
#insp-foot[hidden] { display: none; }
#insp-foot .acts { display: flex; gap: 8px; align-items: center; height: 100%; }
#insp-foot .acts .btn { min-height: 36px; border-radius: 8px; }
#insp-foot .acts .btn-primary { min-width: 86px; }
#insp-foot .acts .btn-secondary { min-width: 58px; }
/* 材料无效/版本漂移的主按钮禁用形态原挂在 .ip-decide 作用域（:1473），
   按钮进底栏后不再命中，按同一组值在 #insp-foot 作用域复刻 */
#insp-foot .acts .btn.btn-invalid-material {
  height: 36px; min-height: 36px; min-width: 86px;
  border-radius: 8px; background: #575044; color: #B4AA99;
  cursor: not-allowed; opacity: 1; filter: none;
}
#insp-foot .acts .btn.btn-invalid-material:disabled { opacity: 1; }
/* 审批卡说明正文按 W01 规格收口：12px/19px；颜色 --meta(var(--meta)) 已是现状，
   G01 层（:1625 附近）把行高压到 18px，这里以更高特异性压回 19px */
#inspector .ev-src { line-height: 19px; }
/* 正文段落全量收口：W02 第 10 轮规格是「正文文字 12px/行高 19px/软文色档」，
   不止 .ev-src 一处——备注(.ip-note :549 是 13px/#F1ECE2)、打回理由(.rej-why :767
   是 12.5px/1.7)、门禁未到与等待前置说明(.ip-sec .ip-v :389 是 13.5px)、需求原文
   (.ev-demand :931 是 13px/1.6)、测试策略说明(.ev-src 只渲染进本面板，全部三处)
   同为面板正文段，字号行高颜色按规格统一（字重 600、区块标题、状态胶囊、文件名、
   警示块语义色均不动）。特异性 (1,1,0)/(1,2,0) 盖过上述各层；颜色只动审批面板，
   中栏 --meta 色板归 G01 管，不随本轮改。 */
#insp-body .ip-note,
#insp-body .rej-why,
#insp-body .ip-sec .ip-v,
#insp-body .ev-demand,
#insp-body .ev-src { font-size: 12px; line-height: 19px; color: var(--text-soft); }

/* ================= F01（第 9 轮）：同一文件多条历史登记的独立校验 =================
   行高封顶 96px（任务书：最小 68px、最大根据内容扩展至 96px）——
   自然数据（汇总两行实测+登记 = 84px）不受影响；构造出的多版本分行超出 96px 时
   按任务书上限截断（overflow:hidden），不再向外无限扩展挤压组内间距。
   文件行底色改 var(--card)（第 9 轮规格，改动在 :1333 主层），边框（--line 档）与
   圆角 8px 维持现状。特异性同 (0,1,0)、置于文件末尾，按源顺序压过前层。 */
.library-file { max-height: 96px; overflow: hidden; }

/* ================= F01（第 10 轮）：登记不同 → 元信息区逐条分行 =================
   登记身份（原始字节数 + 版本标识 + 登记时间）任一不同时，app.js 给行挂 .lf-multi：
   每条登记独立一行（12px/18px/var(--meta-num)/行距 4px，行尾 ✓/≠ 为与实测的逐条结论），
